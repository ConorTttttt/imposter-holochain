+//! Browser alpha lifecycle within one host-bound cell. Legacy cloned games
+//! keep their original indexes and zome calls.
+use super::*;
+
+fn browser_error(why: &str) -> WasmError {
+    wasm_error!(WasmErrorInner::Guest(why.into()))
+}
+
+fn bound_host() -> ExternResult<AgentPubKey> {
+    match parse_game_seed(&dna_info()?.modifiers.network_seed) {
+        Ok(SeedOwner::Host(host)) if host == me()? => Ok(host),
+        _ => Err(browser_error("only the DNA-bound host can create or start a browser lobby")),
+    }
+}
+
+fn browser_root(lobby: ActionHash) -> ExternResult<Record> {
+    let root = must_get_valid_record(lobby)
+        .map_err(|_| browser_error("browser lobby not found or not yet visible"))?;
+    if !app_entry::<Lobby>(&root).is_some_and(|l| browser_lobby_code_valid(&l.code)) {
+        return Err(browser_error("invalid browser lobby action"));
+    }
+    Ok(root)
+}
+
+pub(super) fn records_for_browser_lobby(root: Record) -> ExternResult<Vec<Record>> {
+    let mut records = strict_native_index(root.action_address().clone().into(), LinkTypes::BrowserLobbyIndex)?;
+    records.push(root);
+    Ok(records)
+}
+
+fn resolve_code(code: &str) -> ExternResult<Record> {
+    if !browser_lobby_code_valid(code) {
+        return Err(browser_error("invalid browser lobby code"));
+    }
+    let mut records = strict_native_index(anchor_hash(code)?, LinkTypes::BrowserLobbyIndex)?;
+    match records.pop() {
+        Some(record) if records.is_empty()
+            && app_entry::<Lobby>(&record).is_some_and(|l| l.code == code) => Ok(record),
+        None => Err(browser_error("browser lobby not found or not yet visible")),
+        _ => Err(browser_error("conflicting actions for browser lobby code")),
+    }
+}
+
+fn ensure_index(base: AnyLinkableHash, action: &ActionHash) -> ExternResult<()> {
+    let target: AnyLinkableHash = action.clone().into();
+    let links = get_links(LinkQuery::try_new(base.clone(), LinkTypes::BrowserLobbyIndex)?, GetStrategy::Local)?;
+    if !links.iter().any(|l| l.target == target) {
+        create_link(base, target, LinkTypes::BrowserLobbyIndex, ())?;
+    }
+    Ok(())
+}
+
+pub(super) fn index_round_entry(lobby: &Lobby, root: &ActionHash, action: &ActionHash) -> ExternResult<()> {
+    if browser_lobby_code_valid(&lobby.code) {
+        ensure_index(root.clone().into(), action)
+    } else {
+        link_entry(action)
+    }
+}
+
+fn local_lobbies() -> ExternResult<Vec<Record>> {
+    let mut lobbies: Vec<_> = query(ChainQueryFilter::new().include_entries(true))?
+        .into_iter()
+        .filter(|r| app_entry::<Lobby>(r).is_some_and(|l| browser_lobby_code_valid(&l.code)))
+        .collect();
+    lobbies.sort_by_key(|r| r.action().action_seq());
+    Ok(lobbies)
+}
+
+fn local_join(lobby: &ActionHash, player: &AgentPubKey) -> ExternResult<Option<Record>> {
+    Ok(query(ChainQueryFilter::new().include_entries(true))?
+        .into_iter()
+        .filter(|r| app_entry::<PlayerJoin>(r).is_some_and(|j| &j.lobby == lobby && &j.player == player))
+        .min_by_key(|r| r.action().action_seq()))
+}
+
+fn record_join(lobby: ActionHash, player: AgentPubKey, display_name: String) -> ExternResult<Record> {
+    let join = if let Some(record) = local_join(&lobby, &player)? {
+        record.action_address().clone()
+    } else {
+        create_entry(EntryTypes::PlayerJoin(PlayerJoin { lobby: lobby.clone(), player, display_name }))?
+    };
+    ensure_index(lobby.into(), &join)?;
+    must_get_valid_record(join)
+}
+
+fn open_lobby(code: String, existing: Option<&Record>, display_name: String) -> ExternResult<Record> {
+    let root = if let Some(record) = existing {
+        record.action_address().clone()
+    } else {
+        create_entry(EntryTypes::Lobby(Lobby {
+            code: code.clone(), player_count: 3, impostor_count: 1, task_target: 1,
+        }))?
+    };
+    // Publish the host's seat before advertising the code to guests.
+    record_join(root.clone(), me()?, display_name)?;
+    ensure_index(anchor_hash(&code)?, &root)?;
+    must_get_valid_record(root)
+}
+
+#[hdk_extern]
+pub fn create_browser_lobby(input: JoinLobby) -> ExternResult<Record> {
+    bound_host()?;
+    let lobbies = local_lobbies()?;
+    if let Some(latest) = lobbies.last() {
+        let lobby = app_entry::<Lobby>(latest).ok_or_else(|| browser_error("invalid local lobby"))?;
+        return open_lobby(lobby.code, Some(latest), input.display_name);
+    }
+    let id: String = random_bytes(16)?.as_ref().iter().map(|b| format!("{b:02x}")).collect();
+    open_lobby(format!("{BROWSER_LOBBY_PREFIX}{id}"), None, input.display_name)
+}
+
+#[derive(Serialize, Deserialize, Debug)]
+pub struct NewBrowserGame {
+    pub previous_lobby: ActionHash,
+    pub display_name: String,
+}
+
+#[hdk_extern]
+pub fn new_browser_game(input: NewBrowserGame) -> ExternResult<Record> {
+    bound_host()?;
+    let lobbies = local_lobbies()?;
+    let latest = lobbies.last().ok_or_else(|| browser_error("create the first lobby before starting a new game"))?;
+    let root = browser_root(input.previous_lobby.clone())?;
+    let records = records_for_browser_lobby(root)?;
+    let results: Vec<_> = records.iter().filter(|r| app_entry::<GameResult>(r).is_some()).collect();
+    let [result] = results.as_slice() else {
+        return Err(browser_error("New Game requires one completed native game"));
+    };
+    // The predecessor's immutable result gives retries the very same code,
+    // including after a host restart or an interrupted Lobby/index write.
+    let code = format!("{BROWSER_LOBBY_PREFIX}{}", ActionHashB64::from(result.action_address().clone()));
+    if latest.action_address() != &input.previous_lobby {
+        if app_entry::<Lobby>(latest).is_some_and(|l| l.code == code)
+            && !query(ChainQueryFilter::new().include_entries(true))?.iter().any(|r| {
+                app_entry::<RoleCommit>(r).is_some_and(|c| &c.lobby == latest.action_address())
+            })
+        {
+            return open_lobby(code, Some(latest), input.display_name);
+        }
+        return Err(browser_error("stale lobby: open the host's latest game"));
+    }
+    open_lobby(code, None, input.display_name)
+}
+
+#[derive(Serialize, Deserialize, Debug)]
+pub struct JoinBrowserLobby {
+    pub code: String,
+    pub display_name: String,
+}
+
+#[hdk_extern]
+pub fn join_browser_lobby(input: JoinBrowserLobby) -> ExternResult<Record> {
+    let root = resolve_code(input.code.trim())?;
+    let lobby = app_entry::<Lobby>(&root).ok_or_else(|| browser_error("invalid browser lobby"))?;
+    let action = root.action_address().clone();
+    let host = root.action().author().clone();
+    let records = records_for_browser_lobby(root)?;
+    if records.iter().any(|r| app_entry::<GameResult>(r).is_some()) {
+        return Err(browser_error("this lobby is completed"));
+    }
+    if records.iter().any(|r| app_entry::<RoleCommit>(r).is_some()) {
+        return Err(browser_error("the game has already started"));
+    }
+    let player = me()?;
+    let seats = seated_joins(&records, &action, &host, lobby.player_count as usize);
+    if seats.len() >= lobby.player_count as usize && !seats.iter().any(|(k, _)| k == &player) {
+        return Err(browser_error("game full: all seats are taken"));
+    }
+    record_join(action, player, input.display_name)
+}
+
+/// Recover an existing seat by exact code without writing another join, even
+/// after the game has started or finished.
+#[hdk_extern]
+pub fn reopen_browser_lobby(code: String) -> ExternResult<Record> {
+    let root = resolve_code(code.trim())?;
+    let view = get_authoritative_game_view(NativeGameViewQuery {
+        expected_lobby: root.action_address().clone(),
+        expected_role_commit: None, expected_recipient: None, expected_seat: None,
+    })?;
+    let player = me()?;
+    let seat = view.seats.iter().find(|s| s.agent == player)
+        .ok_or_else(|| browser_error("this identity has no seat in that lobby"))?;
+    must_get_valid_record(seat.join_action.clone())
+}
+
+#[hdk_extern]
+pub fn get_browser_game_state(lobby: ActionHash) -> ExternResult<GameStateView> {
+    project_game_state(records_for_browser_lobby(browser_root(lobby)?)?, false)
+}
+
+#[hdk_extern]
+pub fn start_browser_round(action: ActionHash) -> ExternResult<CommitOnlyResult> {
+    let host = bound_host()?;
+    if !local_lobbies()?.last().is_some_and(|r| r.action_address() == &action) {
+        return Err(browser_error("stale lobby: only the host's latest lobby can start"));
+    }
+    let root = browser_root(action.clone())?;
+    let lobby = app_entry::<Lobby>(&root).ok_or_else(|| browser_error("invalid browser lobby"))?;
+    let records = records_for_browser_lobby(root)?;
+    if records.iter().any(|r| app_entry::<GameResult>(r).is_some()) {
+        return Err(browser_error("this lobby is completed"));
+    }
+    let dealt = ensure_role_commit_in(records, action.clone(), host, lobby)?;
+    let local = query(ChainQueryFilter::new().include_entries(true))?;
+    let task_list = if let Some(record) = local.iter()
+        .find(|r| app_entry::<TaskList>(r).is_some_and(|tasks| tasks.lobby == action)) {
+        record.action_address().clone()
+    } else {
+        create_entry(EntryTypes::TaskList(TaskList {
+            lobby: action.clone(),
+            tasks: vec![Task { id: 0, name: "Align Engine Output".into(), x: 1240, y: 1560 }],
+        }))?
+    };
+    ensure_index(action.into(), &task_list)?;
+    Ok(CommitOnlyResult { role_commit: dealt.role_commit, seats: dealt.seats })
+}
+
+#[hdk_extern]
+pub fn complete_browser_task(action: ActionHash) -> ExternResult<Record> {
+    let records = records_for_browser_lobby(browser_root(action.clone())?)?;
+    if records.iter().any(|r| app_entry::<GameResult>(r).is_some() || app_entry::<RolesReveal>(r).is_some()) {
+        return Err(browser_error("this lobby is completed"));
+    }
+    let mut commits = records.iter().filter_map(app_entry::<RoleCommit>);
+    let player = me()?;
+    if !commits.next().is_some_and(|c| c.seats.contains(&player)) || commits.next().is_some() {
+        return Err(browser_error("this identity has no committed seat in this lobby"));
+    }
+    let mut lists = records.iter().filter(|r| app_entry::<TaskList>(r).is_some());
+    let list = lists.next().ok_or_else(|| browser_error("waiting for the host to publish the task"))?;
+    if lists.next().is_some() {
+        return Err(browser_error("conflicting browser task lists"));
+    }
+    let task_list = list.action_address().clone();
+    let local = query(ChainQueryFilter::new().include_entries(true))?;
+    let completion = if let Some(record) = local.iter()
+        .find(|r| app_entry::<TaskComplete>(r).is_some_and(|t| t.task_list == task_list && t.task_id == 0)) {
+        record.action_address().clone()
+    } else {
+        create_entry(EntryTypes::TaskComplete(TaskComplete { task_list, task_id: 0 }))?
+    };
+    ensure_index(action.into(), &completion)?;
+    must_get_valid_record(completion)
+}
+
+#[hdk_extern]
+pub fn finish_browser_round(action: ActionHash) -> ExternResult<Option<GameResultView>> {
+    let host = bound_host()?;
+    let root = browser_root(action.clone())?;
+    let lobby = app_entry::<Lobby>(&root).ok_or_else(|| browser_error("invalid browser lobby"))?;
+    let records = records_for_browser_lobby(root)?;
+    let local = query(ChainQueryFilter::new().include_entries(true))?;
+    if let Some((record, result)) = local.iter().find_map(|r| {
+        app_entry::<GameResult>(r).filter(|gr| gr.lobby == action).map(|gr| (r, gr))
+    }) {
+        ensure_index(action.into(), record.action_address())?;
+        return Ok(Some(result_view(&result)?));
+    }
+
+    let view = get_authoritative_game_view(NativeGameViewQuery {
+        expected_lobby: action.clone(),
+        expected_role_commit: None, expected_recipient: None, expected_seat: None,
+    })?;
+    if view.host != host || !matches!(view.phase, Phase::Playing) {
+        return Ok(None);
+    }
+    let commit = view.role_commit_action.ok_or_else(|| browser_error("role commitment missing"))?;
+    let rc = records.iter().find(|r| r.action_address() == &commit).and_then(app_entry::<RoleCommit>)
+        .ok_or_else(|| browser_error("role commitment changed"))?;
+    let seal = unique_host_seal(&action)?.ok_or_else(|| browser_error("host private seal missing"))?;
+    if commitment_root(&seal.roles, &seal.salt) != rc.merkle_root {
+        return Err(browser_error("host private seal does not match the role commitment"));
+    }
+
+    let tasks = task_completions(&records, real_tasks(&records, &lobby, &rc, &seal.roles, &seal.salt));
+    let tasks_done = tasks.len() as u32;
+    let impostors_alive = u32::from(lobby.impostor_count);
+    let crew_alive = u32::from(lobby.player_count - lobby.impostor_count);
+    let Some(outcome) = win_outcome(impostors_alive, crew_alive, tasks_done, lobby.task_target) else {
+        return Ok(None);
+    };
+    let reveal = if let Some(record) = local.iter().find(|r|
+        app_entry::<RolesReveal>(r).is_some_and(|rr| rr.role_commit == commit)) {
+        record.action_address().clone()
+    } else {
+        create_entry(EntryTypes::RolesReveal(RolesReveal { role_commit: commit, roles: seal.roles, salt: seal.salt }))?
+    };
+    ensure_index(action.clone().into(), &reveal)?;
+    let result = GameResult {
+        lobby: action.clone(), roles_reveal: reveal, outcome, impostors_alive, crew_alive,
+        tasks_done, tasks_total: lobby.task_target,
+        evidence: tasks.values().map(|r| r.action_address().clone()).collect(),
+        meltdown: None,
+    };
+    let record = create_entry(EntryTypes::GameResult(result.clone()))?;
+    ensure_index(action.into(), &record)?;
+    Ok(Some(result_view(&result)?))
+}
