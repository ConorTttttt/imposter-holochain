+  constructor() { sockets.push(this); }
+
+  open() {
+    this.readyState = TestSocket.OPEN;
+    this.onopen?.();
+  }
+
+  message(payload: object) {
+    this.onmessage?.({ data: JSON.stringify(payload) });
+  }
+
+  send(raw: string) { this.sent.push(JSON.parse(raw)); }
+  close() { this.readyState = 3; }
+}
+
+let executor: FirefoxDirectExecutor;
+const receive = vi.fn();
+const invalidate = vi.fn();
+const pulse = vi.fn();
+
+async function connect() {
+  await executor.configureNetwork({ linkerUrl: "https://gateway.example" });
+  await executor.registerAgent(dna, agent);
+  const socket = sockets.at(-1)!;
+  socket.open();
+  return socket;
+}
+
+async function authenticate(socket: TestSocket) {
+  socket.message({ type: "auth_challenge", challenge: "ab".repeat(32) });
+  await vi.waitFor(() => expect(socket.sent).toContainEqual({
+    type: "auth_challenge_response",
+    signature: btoa(String.fromCharCode(...new Uint8Array(64).fill(1))),
+  }));
+  socket.message({ type: "auth_ok", session_token: "test-session" });
+}
+
+describe("Firefox background role transport", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    vi.stubGlobal("WebSocket", TestSocket);
+    vi.stubGlobal("chrome", { storage: { local: {} } });
+    executor = new FirefoxDirectExecutor();
+    executor.onSignRequest(async () => ({ success: true, signature: Array(64).fill(1) }));
+    executor.setRestrictedRoleHandlers({ receive, invalidate, pulse });
+  });
+
+  afterEach(async () => {
+    await executor.disconnectLinker();
+    sockets.length = 0;
+    vi.unstubAllGlobals();
+  });
+
+  it("requires a challenge response before granting any restricted role lease", async () => {
+    const socket = await connect();
+    socket.message({ type: "auth_ok", session_token: "test-session" });
+    socket.message({ type: "registered", ...registration });
+    socket.message(frame);
+    expect(executor.getRestrictedRoleState()?.lease).toBeNull();
+    expect((await executor.getWebSocketState()).hasSession).toBe(false);
+    expect(receive).not.toHaveBeenCalled();
+    expect(pulse).not.toHaveBeenCalled();
+  });
+
+  it("binds role callbacks and sends to the acknowledged authenticated cell", async () => {
+    const socket = await connect();
+    await authenticate(socket);
+    const lease = executor.getRestrictedRoleState()?.lease;
+    expect(lease).toBeTruthy();
+    socket.message(frame);
+    socket.message({ type: "registered", ...registration, agent_pubkey: other });
+    expect(receive).not.toHaveBeenCalled();
+    expect(() => executor.sendRestrictedRole(frame, lease!)).toThrow();
+
+    socket.message({ type: "registered", ...registration });
+    socket.message({ ...frame, envelope: { ...frame.envelope, recipient_agent: other } });
+    expect(receive).not.toHaveBeenCalled();
+    socket.message(frame);
+    expect(receive).toHaveBeenCalledOnce();
+    expect(receive).toHaveBeenCalledWith(JSON.stringify(frame), lease);
+    expect(executor.sendRestrictedRole(frame, lease!)).toEqual({ success: true });
+
+    socket.readyState = 2;
+    expect(executor.getRestrictedRoleState()?.lease).toBeNull();
+    expect(() => executor.sendRestrictedRole(frame, lease!)).toThrow();
+  });
+
+  it("invalidates revoked registrations and accepts only a new lease after reauthentication", async () => {
+    const before = await connect();
+    await authenticate(before);
+    before.message({ type: "registered", ...registration });
+    const oldLease = executor.getRestrictedRoleState()!.lease!;
+    invalidate.mockClear();
+    executor.unregisterAgent(dna, agent);
+    expect(invalidate).toHaveBeenCalledOnce();
+    expect(() => executor.sendRestrictedRole(frame, oldLease)).toThrow();
+    before.message(frame);
+    expect(receive).not.toHaveBeenCalled();
+
+    await executor.registerAgent(dna, agent);
+    executor.triggerReauth();
+    const after = sockets.at(-1)!;
+    expect(after).not.toBe(before);
+    after.open();
+    await authenticate(after);
+    after.message({ type: "registered", ...registration });
+    const newLease = executor.getRestrictedRoleState()!.lease!;
+    expect(newLease).toBeTruthy();
+    expect(newLease).not.toBe(oldLease);
+    expect(() => executor.sendRestrictedRole(frame, oldLease)).toThrow();
+    after.message(frame);
+    expect(receive).toHaveBeenCalledWith(JSON.stringify(frame), newLease);
+  });
+});
