# P0 authenticated browser-lobby template. Never commit filled-in secrets.
H2HC_LINKER_ADDRESS=127.0.0.1
H2HC_LINKER_PORT=8090
# Replace with an actual reachable compatible Kitsune2 bootstrap.
H2HC_LINKER_BOOTSTRAP_URL=https://REPLACE-WITH-BOOTSTRAP.example
# Generate with openssl rand -hex 32 and save outside the repository.
H2HC_LINKER_ADMIN_SECRET=REPLACE-WITH-RANDOM-SECRET
H2HC_LINKER_ALLOW_INSECURE_DEV=false
H2HC_LINKER_LOCAL_AUTHORITY_FALLBACK=false
H2HC_LINKER_KEY_FILE=/secure/location/h2hc-linker.key
# Intentionally no CONDUCTOR_URL / remote calls.
