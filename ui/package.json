{
  "name": "imposter-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Imposter UI — Holochain client for the consensus moves, PeerKit for movement.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "vite build && cd dist && bestzip ../dist.zip * && cd ..",
    "relay": "tsx src/relay.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/game/*.test.ts src/browser/*.test.ts"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@holochain/client": "^0.21.0",
    "@libp2p/circuit-relay-v2": "^4.2.13",
    "@libp2p/dcutr": "^3.0.28",
    "@libp2p/identify": "^4.1.14",
    "@libp2p/webrtc": "^6.0.32",
    "@logtape/logtape": "^2.3.2",
    "@msgpack/msgpack": "^3.0.0",
    "@noble/hashes": "^2.4.0",
    "@peerkit/agent-store": "0.1.0-alpha.15",
    "@peerkit/api": "0.1.0-alpha.15",
    "@peerkit/peerkit": "0.1.0-alpha.15",
    "@peerkit/transport-libp2p": "0.1.0-alpha.15",
    "@peerkit/transport-libp2p-core": "0.1.0-alpha.15",
    "libp2p": "^3.3.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "8.18.2",
    "bestzip": "^2.2.1",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.23.0",
    "ws": "8.21.3"
  }
}
