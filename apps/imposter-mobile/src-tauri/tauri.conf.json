{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Imposter",
  "version": "0.1.0",
  "identifier": "dev.imposter.holochain",
  "build": {
    "beforeDevCommand": "npm --prefix ../../ui run dev -- --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../ui run build",
    "frontendDist": "../../../ui/dist"
  },
  "app": {
    "windows": [
      { "title": "Imposter", "width": 960, "height": 640 }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 28
    }
  }
}
